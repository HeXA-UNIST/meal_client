<?xml version="1.0" encoding="utf-8"?>
<!-- 단일 통합 위젯 (시안 2×2 카드: 헤더 → 그라데이션 메뉴 패널 → 하단 운영상태).
     치수는 Figma 320px 카드 ÷2 기준 (카드 padding 상12/좌우11/하10, 패널 radius 11dp 등). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:paddingBottom="10dp">

    <!-- 헤더: [식당명 음식종류] ··· [식사시간] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cafeteria_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/cafeteria_dormitory"
                android:textColor="@color/widget_text_cafeteria"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/pretendard"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_food_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/food_korean"
                android:textColor="@color/widget_text_food_type"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/pretendard"
                android:letterSpacing="-0.02"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_meal_of_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meal_lunch"
            android:textColor="@color/widget_text_meal"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/pretendard"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <!-- 메뉴 패널: 둥근 그라데이션 상자 안에 메뉴 목록 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_menu_panel_background"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="20"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_text_menu"
            android:textSize="10sp"
            android:fontFamily="@font/pretendard"
            android:letterSpacing="-0.01"
            android:lineSpacingExtra="4sp"
            android:gravity="top" />
    </FrameLayout>

    <!-- 운영 상태 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/widget_status_before"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="@font/pretendard"
        android:letterSpacing="-0.02"
        android:gravity="center"
        android:textAlignment="center" />
</LinearLayout>
