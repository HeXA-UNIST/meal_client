<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 두 식당 위젯 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- 왼쪽 패널 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cafeteria_name_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/cafeteria_dormitory"
                android:textColor="@color/widget_text_cafeteria"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_food_type_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/food_korean"
                android:textColor="@color/widget_text_food_type"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_meal_of_day_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_lunch"
                android:textColor="@color/widget_text_meal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_menu_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="6"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_text_menu"
            android:textSize="12sp"
            android:fontFamily="@font/spoqa_han_sans_neo"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="3sp" />

        <TextView
            android:id="@+id/tv_kcal_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/widget_text_kcal"
            android:textSize="10sp"
            android:fontFamily="@font/spoqa_han_sans_neo"
            android:letterSpacing="-0.02"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- 오른쪽 패널 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cafeteria_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/cafeteria_student"
                android:textColor="@color/widget_text_cafeteria"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_food_type_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/food_korean"
                android:textColor="@color/widget_text_food_type"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_meal_of_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_lunch"
                android:textColor="@color/widget_text_meal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/spoqa_han_sans_neo"
                android:letterSpacing="-0.02" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_menu_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="6"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_text_menu"
            android:textSize="12sp"
            android:fontFamily="@font/spoqa_han_sans_neo"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="3sp" />

        <TextView
            android:id="@+id/tv_kcal_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/widget_text_kcal"
            android:textSize="10sp"
            android:fontFamily="@font/spoqa_han_sans_neo"
            android:letterSpacing="-0.02"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>
</LinearLayout>
