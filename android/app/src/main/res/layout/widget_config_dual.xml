<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_config_dual"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/config_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/widget_config_title"
            android:textColor="@color/config_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 첫 번째 식당 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/widget_config_first"
            android:textColor="@color/config_text_hint"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/item0_dorm_korean"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv0_dorm_korean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_dorm_korean"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot0_dorm_korean"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item0_dorm_halal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv0_dorm_halal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_dorm_halal"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot0_dorm_halal"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item0_student"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv0_student"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_student"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot0_student"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item0_faculty"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv0_faculty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_faculty"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot0_faculty"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 두 번째 식당 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/widget_config_second"
            android:textColor="@color/config_text_hint"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/item1_dorm_korean"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv1_dorm_korean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_dorm_korean"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot1_dorm_korean"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item1_dorm_halal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv1_dorm_halal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_dorm_halal"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot1_dorm_halal"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item1_student"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv1_student"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_student"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot1_student"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item1_faculty"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/widget_config_item_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv1_faculty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cafeteria_faculty"
                android:textColor="@color/config_text_primary"
                android:textSize="15sp" />
            <View
                android:id="@+id/dot1_faculty"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_status_dot_open"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/widget_config_btn"
            android:text="@string/widget_config_confirm"
            android:textColor="@color/config_btn_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
