<?xml version="1.0" encoding="utf-8"?>
<!-- 권한이 없는 기존 위젯도 ID를 유지하며, 탭으로 시스템 설정을 열 수 있게 한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_exact_alarm_notice_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_exact_alarm_notice_body"
        android:textColor="@color/widget_text_menu"
        android:textSize="12sp"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tv_exact_alarm_notice_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_exact_alarm_notice_action"
        android:textColor="@color/widget_status_open"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />
</LinearLayout>
