<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="main_color">#00CD80</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- 위젯 색상 (라이트 기본값 / 다크는 values-night/colors.xml) -->
    <color name="widget_bg">#F2F2F7</color>
    <color name="widget_text_secondary">#717171</color>
    <color name="widget_card_bg">#FFFFFF</color>

    <!-- 위젯 메뉴 패널 (시안: 카드 안 둥근 그라데이션 상자, 180° #F6F6F8→#F1F1F4) -->
    <color name="widget_menu_panel_start">#F6F6F8</color>
    <color name="widget_menu_panel_end">#F1F1F4</color>

    <!-- 식당명은 라이트 모드에서 시각적 브랜드를 우선해 원색을 유지한다. -->
    <color name="widget_text_cafeteria">#00CD80</color>
    <color name="widget_text_meal">#000000</color>
    <color name="widget_text_food_type">#000000</color>
    <color name="widget_text_menu">#2E2E2E</color>

    <!-- 운영 상태 색상 -->
    <!-- 작은 상태 텍스트는 브랜드 hue(약 158°)를 유지하면서
         카드 배경에서 APCA |Lc| 약 75 이상이 되도록 조정한다. -->
    <color name="widget_status_open">#147549</color>
    <color name="widget_status_closing">#000000</color>
    <color name="widget_status_closed">#526057</color>
    <color name="widget_status_before">#526057</color>

    <!-- 위젯 설정 화면 색상 (라이트 기본값 / 다크는 values-night/colors.xml) -->
    <color name="config_bg">#F5F5F7</color>
    <color name="config_item_bg">#FFFFFF</color>
    <color name="config_item_selected_bg">#E4F9F0</color>
    <color name="config_text_primary">#000000</color>
    <color name="config_text_hint">#717171</color>
    <color name="config_btn_text">#000000</color>
</resources>
